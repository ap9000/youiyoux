{
  "$schema": "../../schema/youi.component.schema.json",
  "schema": "youi.component/v1",
  "id": "youi:signal/component/label",
  "name": "Label",
  "version": "1.0.0",
  "status": "stable",
  "summary": "A field label in caption weight, linked to its control.",
  "source": {
    "file": "_shared/form-controls.tsx",
    "export": "Label",
    "also": []
  },
  "platforms": [
    "web"
  ],
  "passthrough": "label",
  "props": {
    "htmlFor": {
      "type": "string",
      "description": "The id of the control it names."
    },
    "className": {
      "type": "string",
      "description": "Extra classes, merged last with cn(); use token utilities only."
    },
    "children": {
      "type": "node"
    }
  },
  "tokens": {
    "text": "youi:signal/token/typography.caption"
  },
  "a11y": {
    "notes": [
      "Always set htmlFor; a label without a control is just text."
    ]
  },
  "rules": [
    "youi:signal/rule/color.no-raw-color",
    "youi:signal/rule/tokens.no-arbitrary-values",
    "youi:signal/rule/components.canonical-import"
  ],
  "guidance": {
    "do": [
      "Use sentence case."
    ],
    "dont": [
      "Don't use uppercase, letter-spaced labels."
    ]
  },
  "examples": [
    {
      "title": "Label",
      "code": "<Label htmlFor=\"repo\">Repository</Label>"
    }
  ],
  "aliases": [],
  "owners": [
    "group:design-system"
  ]
}
