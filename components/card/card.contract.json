{
  "$schema": "../../schema/youi.component.schema.json",
  "schema": "youi.component/v1",
  "id": "youi:signal/component/card",
  "name": "Card",
  "version": "1.0.0",
  "status": "stable",
  "summary": "A flat paper container defined by its hairline border. No shadow inside a sheet, never nested.",
  "source": {
    "file": "card/card.tsx",
    "export": "Card",
    "also": [
      "CardHeader",
      "CardTitle",
      "CardDescription",
      "CardContent"
    ]
  },
  "platforms": [
    "web"
  ],
  "passthrough": "section",
  "props": {
    "className": {
      "type": "string",
      "description": "Extra classes, merged last with cn(); use token utilities only."
    },
    "children": {
      "type": "node"
    }
  },
  "tokens": {
    "bg": "youi:signal/token/color.paper",
    "border": "youi:signal/token/color.line",
    "radius": "youi:signal/token/radius.card"
  },
  "a11y": {
    "notes": [
      "CardTitle renders an h2; keep the page's heading order."
    ]
  },
  "rules": [
    "youi:signal/rule/color.no-raw-color",
    "youi:signal/rule/tokens.no-arbitrary-values",
    "youi:signal/rule/components.canonical-import"
  ],
  "guidance": {
    "do": [
      "Separate a card's blocks with 16px gaps (12px on phones)."
    ],
    "dont": [
      "Don't nest cards or give a card a shadow.",
      "Don't colour a card's border to announce a wait; only a failed card takes vermilion at 50%."
    ]
  },
  "examples": [
    {
      "title": "Card with header",
      "code": "<Card><CardHeader><CardTitle>Result</CardTitle></CardHeader><CardContent>…</CardContent></Card>"
    }
  ],
  "aliases": [],
  "owners": [
    "group:design-system"
  ]
}
