{
  "$schema": "../../schema/youi.component.schema.json",
  "schema": "youi.component/v1",
  "id": "youi:signal/component/badge",
  "name": "Badge",
  "version": "1.0.0",
  "status": "stable",
  "summary": "A status chip: sentence-case text in a hue on its soft wash. Colour belongs on the badge, not the row.",
  "source": {
    "file": "badge/badge.tsx",
    "export": "Badge",
    "also": []
  },
  "platforms": [
    "web"
  ],
  "passthrough": "span",
  "props": {
    "tone": {
      "type": "enum",
      "values": [
        "neutral",
        "success",
        "warning",
        "attention",
        "danger",
        "info"
      ],
      "default": "neutral",
      "description": "neutral = a fact; attention = a person is needed; danger = failed; warning = setup trouble; info = live; success = done."
    },
    "className": {
      "type": "string",
      "description": "Extra classes, merged last with cn(); use token utilities only."
    },
    "children": {
      "type": "node"
    }
  },
  "tokens": {
    "bg.neutral": "youi:signal/token/color.neutral-soft",
    "fg.neutral": "youi:signal/token/color.neutral-ink",
    "bg.attention": "youi:signal/token/color.attention-soft",
    "fg.attention": "youi:signal/token/color.attention",
    "radius": "youi:signal/token/radius.badge",
    "text": "youi:signal/token/typography.badge"
  },
  "a11y": {
    "notes": [
      "Never convey state by colour alone: the badge text names the state."
    ]
  },
  "rules": [
    "youi:signal/rule/color.no-raw-color",
    "youi:signal/rule/tokens.no-arbitrary-values",
    "youi:signal/rule/components.canonical-import",
    "youi:signal/rule/props.contract-values"
  ],
  "guidance": {
    "do": [
      "Map a task status to a tone in one place (toneOf) so every surface agrees."
    ],
    "dont": [
      "Don't repeat a state its group heading already names.",
      "Don't use uppercase or letter-spaced badge text."
    ]
  },
  "examples": [
    {
      "title": "Waiting on a person",
      "code": "<Badge tone=\"attention\">Needs your decision</Badge>"
    },
    {
      "title": "A neutral fact",
      "code": "<Badge>Queued</Badge>"
    }
  ],
  "aliases": [
    "badgeVariants"
  ],
  "owners": [
    "group:design-system"
  ]
}
