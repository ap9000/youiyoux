{
  "$schema": "../../schema/youi.component.schema.json",
  "schema": "youi.component/v1",
  "id": "youi:signal/component/input",
  "name": "Input",
  "version": "1.0.0",
  "status": "stable",
  "summary": "A single-line field: paper fill, control-line border, 8px corners, 32px tall (44px and 16px text on phones).",
  "source": {
    "file": "_shared/form-controls.tsx",
    "export": "Input",
    "also": []
  },
  "platforms": [
    "web"
  ],
  "passthrough": "input",
  "props": {
    "type": {
      "type": "string",
      "default": "text"
    },
    "className": {
      "type": "string",
      "description": "Extra classes, merged last with cn(); use token utilities only."
    }
  },
  "tokens": {
    "bg": "youi:signal/token/color.paper",
    "border": "youi:signal/token/color.input-line",
    "radius": "youi:signal/token/radius.md",
    "text": "youi:signal/token/typography.body"
  },
  "a11y": {
    "minTouchTarget": 44,
    "notes": [
      "Pair every Input with a Label (htmlFor/id).",
      "Show errors as a vermilion alert, never a red border alone."
    ]
  },
  "rules": [
    "youi:signal/rule/color.no-raw-color",
    "youi:signal/rule/tokens.no-arbitrary-values",
    "youi:signal/rule/components.canonical-import"
  ],
  "guidance": {
    "do": [
      "Use 16px text on phones so iOS does not zoom."
    ],
    "dont": [
      "Don't signal an error with a red border alone."
    ]
  },
  "examples": [
    {
      "title": "Labelled field",
      "code": "<Label htmlFor=\"name\">Name</Label>\n<Input id=\"name\" name=\"name\" />"
    }
  ],
  "aliases": [],
  "owners": [
    "group:design-system"
  ]
}
