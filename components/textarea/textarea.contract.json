{
  "$schema": "../../schema/youi.component.schema.json",
  "schema": "youi.component/v1",
  "id": "youi:signal/component/textarea",
  "name": "Textarea",
  "version": "1.0.0",
  "status": "stable",
  "summary": "A multi-line field with the Input's material: paper, control line, 8px corners.",
  "source": {
    "file": "_shared/form-controls.tsx",
    "export": "Textarea",
    "also": []
  },
  "platforms": [
    "web"
  ],
  "passthrough": "textarea",
  "props": {
    "className": {
      "type": "string",
      "description": "Extra classes, merged last with cn(); use token utilities only."
    }
  },
  "tokens": {
    "bg": "youi:signal/token/color.paper",
    "border": "youi:signal/token/color.input-line",
    "radius": "youi:signal/token/radius.md",
    "text": "youi:signal/token/typography.body"
  },
  "a11y": {
    "notes": [
      "Pair with a Label."
    ]
  },
  "rules": [
    "youi:signal/rule/color.no-raw-color",
    "youi:signal/rule/tokens.no-arbitrary-values",
    "youi:signal/rule/components.canonical-import"
  ],
  "guidance": {
    "do": [
      "Use for prose a person writes (requests, notes)."
    ],
    "dont": [
      "Don't use for single values."
    ]
  },
  "examples": [
    {
      "title": "Request changes",
      "code": "<Textarea name=\"note\" placeholder=\"What should change?\" />"
    }
  ],
  "aliases": [],
  "owners": [
    "group:design-system"
  ]
}
