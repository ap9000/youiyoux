{
  "$schema": "../../schema/youi.component.schema.json",
  "schema": "youi.component/v1",
  "id": "youi:signal/component/switch",
  "name": "Switch",
  "version": "1.0.0",
  "status": "stable",
  "summary": "An on/off control: ink track when on, control line when off.",
  "source": {
    "file": "switch/switch.tsx",
    "export": "Switch",
    "also": []
  },
  "platforms": [
    "web"
  ],
  "props": {
    "checked": {
      "type": "boolean"
    },
    "defaultChecked": {
      "type": "boolean"
    },
    "onCheckedChange": {
      "type": "function"
    },
    "disabled": {
      "type": "boolean"
    },
    "name": {
      "type": "string"
    }
  },
  "tokens": {
    "on": "youi:signal/token/color.accent",
    "off": "youi:signal/token/color.input-line",
    "thumb": "youi:signal/token/color.paper"
  },
  "a11y": {
    "role": "switch",
    "minTouchTarget": 44,
    "notes": [
      "Label it: aria-label or a Label with htmlFor."
    ]
  },
  "rules": [
    "youi:signal/rule/color.no-raw-color",
    "youi:signal/rule/tokens.no-arbitrary-values",
    "youi:signal/rule/components.canonical-import"
  ],
  "guidance": {
    "do": [
      "Use for a setting that applies immediately."
    ],
    "dont": [
      "Don't use a switch for a choice that needs a Save."
    ]
  },
  "examples": [
    {
      "title": "Setting",
      "code": "<Switch id=\"alerts\" name=\"alerts\" defaultChecked /><Label htmlFor=\"alerts\">Send alerts</Label>"
    }
  ],
  "aliases": [],
  "owners": [
    "group:design-system"
  ]
}
