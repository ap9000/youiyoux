{
  "$schema": "../../schema/youi.component.schema.json",
  "schema": "youi.component/v1",
  "id": "youi:signal/component/tabs",
  "name": "Tabs",
  "version": "1.0.0",
  "status": "stable",
  "summary": "Segmented tabs: a raised track holding paper-pill triggers. Filters stay real URLs where they can.",
  "source": {
    "file": "tabs/tabs.tsx",
    "export": "Tabs",
    "also": [
      "TabsList",
      "TabsTrigger",
      "TabsContent"
    ]
  },
  "platforms": [
    "web"
  ],
  "props": {
    "value": {
      "type": "string"
    },
    "defaultValue": {
      "type": "string"
    },
    "onValueChange": {
      "type": "function"
    },
    "children": {
      "type": "node"
    }
  },
  "tokens": {
    "track": "youi:signal/token/color.raised",
    "active": "youi:signal/token/color.paper",
    "shadow": "youi:signal/token/shadow.pill",
    "radius": "youi:signal/token/radius.sheet",
    "text": "youi:signal/token/typography.label"
  },
  "a11y": {
    "role": "tablist",
    "notes": [
      "Radix handles arrow-key navigation; keep each trigger's text unique."
    ]
  },
  "rules": [
    "youi:signal/rule/color.no-raw-color",
    "youi:signal/rule/tokens.no-arbitrary-values",
    "youi:signal/rule/components.canonical-import"
  ],
  "guidance": {
    "do": [
      "Use link tabs (real URLs) for views a person bookmarks."
    ],
    "dont": [
      "Don't colour a tab count unless it is the needs-you count above zero."
    ]
  },
  "examples": [
    {
      "title": "Tabs",
      "code": "<Tabs defaultValue=\"overview\"><TabsList><TabsTrigger value=\"overview\">Overview</TabsTrigger></TabsList><TabsContent value=\"overview\">…</TabsContent></Tabs>"
    }
  ],
  "aliases": [],
  "owners": [
    "group:design-system"
  ]
}
