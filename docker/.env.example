# Copy to .env beside compose.yml and fill in. Keep .env out of git: it holds the hub's secrets.

# The image's version. Pin it (e.g. 0.1.28) so an upgrade is a change you make; latest follows each release.
YOUIYOUX_VERSION=latest

# The database's password: openssl rand -hex 24 (hex, so it needs no escaping in a URL).
POSTGRES_PASSWORD=

# For people: the key they sign in with once. openssl rand -base64 32
YOUIYOUX_HUB_VIEW_KEY=

# Who may send records. GitHub Actions: the owners' numeric ids (gh api orgs/acme --jq .id), comma-separated,
# and the hub's https address exactly as CI's YOUIYOUX_HUB_URL secret names it.
YOUIYOUX_HUB_GITHUB_OWNERS=
YOUIYOUX_HUB_AUDIENCE=
# Branches records are taken from (default main and master).
YOUIYOUX_HUB_BRANCHES=
# CI other than GitHub's: leave the owners empty and set a shared token instead (openssl rand -base64 32).
YOUIYOUX_HUB_TOKEN=

# The https profile (docker compose --profile https up -d): the hub's domain, pointed at this machine.
YOUIYOUX_DOMAIN=
# The port the hub answers on, on this machine only (default 8080).
YOUIYOUX_PORT=
