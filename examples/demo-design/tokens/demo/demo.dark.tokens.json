    "background": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0706,
          0.0706,
          0.0784
        ],
        "hex": "#121214"
      }
    },
    "foreground": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9255,
          0.9255,
          0.9451
        ],
        "hex": "#ececf1"
      }
    },
    "muted": {
      "$type": "color",
      "$value": {
