{
  "$schema": "https://www.designtokens.org/schemas/2025.10/resolver.json",
  "name": "Signal",
  "version": "2025.10",
  "description": "Signal tokens: one base set plus a theme modifier whose dark context overrides the values that change.",
  "sets": {
    "base": {
      "sources": [
        {
          "$ref": "signal.tokens.json"
        }
      ]
    }
  },
  "modifiers": {
    "theme": {
      "contexts": {
        "light": [],
        "dark": [
          {
            "$ref": "signal.dark.tokens.json"
          }
        ]
      },
      "default": "light"
    }
  },
  "resolutionOrder": [
    {
      "$ref": "#/sets/base"
    },
    {
      "$ref": "#/modifiers/theme"
    }
  ]
}
