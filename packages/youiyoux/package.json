{
  "name": "youiyoux",
  "version": "0.1.0",
  "description": "A shareable report on any repo's UI with no setup: npx youiyoux. Components, near-duplicates, hardcoded values a token holds, off-library imports and the top fixes; plus the youi CLI.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "youiyoux": "./dist/youiyoux.js",
    "youi": "./dist/youi.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "design-system",
    "ui",
    "components",
    "tailwind",
    "shadcn",
    "audit"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs"
  },
  "dependencies": {
    "@ast-grep/napi": "0.45.3",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.63.0",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@youiyoux/cli": "workspace:*",
    "@youiyoux/core": "workspace:*",
    "@youiyoux/scanner": "workspace:*"
  },
  "exports": {
    "./package.json": "./package.json"
  }
}
