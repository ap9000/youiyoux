{
  "$id": "https://design-language.local/schema/youi.proposal.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "type": "string",
      "const": "youi.proposal/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^p-[0-9a-f]{10}$"
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "route": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "target": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "element": {
          "type": "string",
          "pattern": "^youi:([a-z][a-z0-9-]*)\\/(token|component|rule|migration)\\/([a-z0-9][a-z0-9.\\-]*)$"
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "line": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "column": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "box": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number",
              "minimum": 0
            },
            "height": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "x",
            "y",
            "width",
            "height"
          ]
        },
        "page": {
          "type": "object",
          "properties": {
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "width",
            "height"
          ]
        }
      },
      "required": [
        "name",
        "box"
      ]
    },
    "ask": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "author": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "person",
            "agent"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "kind",
        "name"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "options": {
      "minItems": 2,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "a",
              "b",
              "c",
              "d"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "set": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "prop": {
                  "type": "string",
                  "pattern": "^[A-Za-z_$][\\w$]{0,63}$"
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 2000
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                }
              },
              "required": [
                "prop",
                "value"
              ]
            }
          },
          "text": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "label",
          "why",
          "set",
          "text"
        ]
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "chosen",
        "dismissed"
      ]
    },
    "choice": {
      "type": "string",
      "enum": [
        "a",
        "b",
        "c",
        "d"
      ]
    },
    "decidedBy": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "person",
            "agent"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "kind",
        "name"
      ]
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "request": {
      "type": "string",
      "pattern": "^r-[0-9a-f]{10}$"
    },
    "for": {
      "type": "string",
      "pattern": "^r-[0-9a-f]{10}$"
    }
  },
  "required": [
    "schema",
    "id",
    "project",
    "route",
    "target",
    "ask",
    "author",
    "createdAt",
    "updatedAt",
    "options",
    "status"
  ]
}
