{
  "$id": "https://design-language.local/schema/youi.request-task.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "type": "string",
      "const": "youi.request-task/v1"
    },
    "request": {
      "type": "string",
      "pattern": "^r-[0-9a-f]{10}$"
    },
    "runner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "task": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000,
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "url"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "needs-you",
        "building",
        "ready",
        "done",
        "failed",
        "stopped"
      ]
    },
    "detail": {
      "type": "string",
      "maxLength": 300
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "schema",
    "request",
    "runner",
    "task",
    "status",
    "updatedAt"
  ]
}
