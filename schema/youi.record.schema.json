{
  "$id": "https://design-language.local/schema/youi.record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "type": "string",
      "const": "youi.record/v1"
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][\\w.-]{0,99}\\/[\\w.-]{1,100}$"
    },
    "commit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "ref": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "tool": {
      "type": "string",
      "maxLength": 50
    },
    "products": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "root": {
                "type": "string"
              },
              "system": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  },
                  "linked": {
                    "type": "boolean"
                  },
                  "commit": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "id",
                  "name",
                  "version",
                  "source",
                  "linked",
                  "commit"
                ]
              },
              "lock": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "systemVersion": {
                        "type": "string"
                      },
                      "syncedAt": {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                      }
                    },
                    "required": [
                      "systemVersion",
                      "syncedAt"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sync": {
                "type": "object",
                "properties": {
                  "state": {
                    "type": "string",
                    "enum": [
                      "current",
                      "behind",
                      "conflict",
                      "never"
                    ]
                  },
                  "changes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "file": {
                          "type": "string"
                        },
                        "action": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "file",
                        "action"
                      ]
                    }
                  }
                },
                "required": [
                  "state",
                  "changes"
                ]
              },
              "drift": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "file": {
                      "type": "string"
                    },
                    "severity": {
                      "type": "string",
                      "enum": [
                        "error",
                        "warn"
                      ]
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "file",
                    "severity",
                    "message"
                  ]
                }
              },
              "check": {
                "type": "object",
                "properties": {
                  "errors": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "warnings": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "baseline": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "known": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "new": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "fixed": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "known",
                          "new",
                          "fixed"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "incomplete": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "errors",
                  "warnings",
                  "baseline",
                  "incomplete"
                ]
              },
              "components": {
                "type": "object",
                "properties": {
                  "system": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "used": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "sites": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "system",
                  "used",
                  "sites"
                ]
              },
              "requests": {
                "type": "object",
                "properties": {
                  "open": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "addressed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "unreadable": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "open",
                  "addressed",
                  "unreadable"
                ]
              },
              "next": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "root",
              "system",
              "lock",
              "sync",
              "drift",
              "check",
              "components",
              "requests",
              "next"
            ]
          },
          {
            "type": "object",
            "properties": {
              "root": {
                "type": "string"
              },
              "error": {
                "type": "string"
              },
              "next": {
                "type": "string"
              }
            },
            "required": [
              "root",
              "error",
              "next"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "schema",
    "repo",
    "commit",
    "ref",
    "generatedAt",
    "tool",
    "products"
  ],
  "additionalProperties": false
}
