{
  "$id": "https://design-language.local/schema/youi.gaps.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "type": "string",
      "const": "youi.gaps/v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "system": {
      "type": [
        "string",
        "null"
      ]
    },
    "discover": {
      "type": "string",
      "enum": [
        "synced",
        "not-synced"
      ]
    },
    "kit": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "complete": {
            "type": "boolean"
          },
          "dependencies": {
            "type": "string",
            "enum": [
              "read",
              "unread"
            ]
          },
          "concepts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "concept": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "system",
                    "library",
                    "hand-built",
                    "missing"
                  ]
                },
                "system": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "packages": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "definitions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "file": {
                        "type": "string"
                      },
                      "line": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "name",
                      "file",
                      "line"
                    ]
                  }
                },
                "count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "uses": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "files": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "candidates": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "source": {
                            "type": "string"
                          },
                          "licence": {
                            "type": "string"
                          },
                          "copyleft": {
                            "type": "boolean"
                          },
                          "install": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "name",
                          "source",
                          "licence",
                          "copyleft",
                          "install"
                        ]
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "concept",
                "name",
                "status",
                "system",
                "packages",
                "definitions",
                "count",
                "uses",
                "files",
                "candidates"
              ]
            }
          }
        },
        "required": [
          "id",
          "complete",
          "dependencies",
          "concepts"
        ]
      }
    },
    "across": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "concept": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "projects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "uses": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "concept",
          "name",
          "projects",
          "uses"
        ]
      }
    }
  },
  "required": [
    "schema",
    "generatedAt",
    "system",
    "discover",
    "kit",
    "projects",
    "across"
  ]
}
