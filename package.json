{
  "name": "youiyoux",
  "version": "0.1.0",
  "private": true,
  "description": "YouIyouX: the company design language. Definitions (DTCG tokens, youi.component/v1 contracts, rules, migrations) plus the youi CLI, scanner and MCP server.",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "youi": "node packages/cli/bin/youi.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "schemas": "node packages/cli/bin/youi.js schema --write"
  },
  "devDependencies": {
    "@youiyoux/cli": "workspace:*",
    "@youiyoux/core": "workspace:*",
    "@youiyoux/mcp": "workspace:*",
    "@youiyoux/scanner": "workspace:*",
    "@youiyoux/tokens": "workspace:*",
    "@types/node": "26.6.3",
    "typescript": "6.0.3",
    "vitest": "5.0.1",
    "yaml": "2.9.1"
  }
}
