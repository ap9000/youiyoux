{
  "name": "youiyoux-workspace",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "YouIyouX: design-language tooling. The youi CLI, scanner, MCP server and hub; design systems live in their own repos.",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "youi": "node packages/cli/bin/youi.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "schemas": "node packages/cli/bin/youi.js schema --write"
  },
  "devDependencies": {
    "@youiyoux/cli": "workspace:*",
    "@youiyoux/core": "workspace:*",
    "@youiyoux/detect": "workspace:*",
    "@youiyoux/discover": "workspace:*",
    "@youiyoux/mcp": "workspace:*",
    "@youiyoux/scanner": "workspace:*",
    "@youiyoux/store": "workspace:*",
    "@youiyoux/tokens": "workspace:*",
    "@youiyoux/workflow": "workspace:*",
    "@types/node": "26.6.3",
    "typescript": "6.0.3",
    "vitest": "5.0.1",
    "yaml": "2.9.1"
  }
}
